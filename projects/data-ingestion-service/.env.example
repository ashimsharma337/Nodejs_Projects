# ETL Consumer config
PROVIDER_URL=http://localhost:4000/data
PAGE_LIMIT=500

# Postgres config
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=yourpassword
PG_DATABASE=etl_db
PG_MAX_CLIENTS=10

# Scheduler (cron) format — runs daily at 02:00 by default
CRON_SCHEDULE=0 2 * * *
BATCH_SIZE=500

# Note: Copy to .env and fill values before running.
